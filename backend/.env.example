# Copy to backend/.env and adjust locally.
# Real .env files are ignored by the repository root .gitignore.

# Knowledge base to vectorize and search.
PORTO_CHATBOT_KB_PATH=~/.scv/analysis

# Local index and generated workflow output directory.
PORTO_CHATBOT_DATA_DIR=~/.porto

# RAG pipeline（推荐组合 = 语义 embedding + condense 指代消解，2026-08 消融实证：
#   qwen3 embedding 7 场景 recall +0.08、multidoc +0.15；condense 多轮 +0.24 且单轮零影响）
# 有 ollama 的部署用 ollama 语义 embedding；无外部依赖的 dev/测试用 local（哈希兜底）。
PORTO_CHATBOT_EMBEDDING_PROVIDER=ollama
PORTO_CHATBOT_EMBEDDING_MODEL=qwen3-embedding:0.6b
PORTO_CHATBOT_EMBEDDING_BASE_URL=http://127.0.0.1:11434
PORTO_CHATBOT_MAX_CHUNK_CHARS=1400
PORTO_CHATBOT_CHUNK_OVERLAP=180
PORTO_CHATBOT_TOP_K=6
# condense 门控默认开启（可关）；multi_query/rerank 为可选增强（每查询 +1 次 LLM 调用）
PORTO_CHATBOT_CONDENSE_ENABLED=true

# Agent LLM behavior. If LANGCHAIN_API_KEY is omitted, the backend uses
# deterministic local logic for tests/dev.
LANGCHAIN_AGENT_PROVIDER=openai
LANGCHAIN_MODEL=gpt-4.1-mini
LANGCHAIN_BASE_URL=
LANGCHAIN_API_KEY=
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_MAX_TOKENS=2000

# Uploaded PRD parsing. hybrid uses native PDF vision when the configured model
# supports it and falls back to local parsing; local never sends file contents
# to the model; native fails the request when native PDF understanding is unavailable.
PORTO_CHATBOT_DOCUMENT_PARSE_MODE=hybrid
# pypdf is lightweight; docling adds local OCR/layout parsing and requires:
#   uv sync --extra document-ai
PORTO_CHATBOT_DOCUMENT_LOCAL_PARSER=pypdf
PORTO_CHATBOT_DOCUMENT_MAX_TOKENS=16000
PORTO_CHATBOT_DOCUMENT_MAX_UPLOAD_MB=20
PORTO_CHATBOT_DOCUMENT_MAX_PDF_PAGES=200

# Anthropic example:
# LANGCHAIN_AGENT_PROVIDER=anthropic
# LANGCHAIN_MODEL=claude-3-5-sonnet-latest
# LANGCHAIN_BASE_URL=
# LANGCHAIN_API_KEY=...

# Optional LangSmith tracing for LangGraph runs.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=porto-chatbot
